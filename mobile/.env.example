# Optional. Omit to use production https://smart-kredit.vercel.app (APIs use that origin).
# Local Android emulator → host machine:
# EXPO_PUBLIC_WEB_APP_ORIGIN=http://10.0.2.2:3055

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth (Web client ID required for Expo Google + Firebase). Android client ID for release/debug SHA-1.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Must match server NEXT_PUBLIC_DEV_OTP_BYPASS when using dev phone login without SMS.
EXPO_PUBLIC_DEV_OTP_BYPASS=false
